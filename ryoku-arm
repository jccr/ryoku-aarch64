#!/usr/bin/env bash
# ryoku-arm: install and keep the Ryoku desktop current on aarch64 (Asahi).
#
# Upstream Ryoku ships x86_64 packages only. This builds it from a source
# checkout and fills what the [ryoku] packages do on x86 (dependencies, the
# arch=any packages, configs a checkout deploy misses), then hands the desktop
# itself to Ryoku's own `ryoku update`. install and update run the same
# ordered, idempotent steps (steps/NN-*.sh); each checks the machine and acts
# only where it differs from what the saved choices ask for.
#
# Layout: lib/ shared helpers, steps/ one step per file (NN = order),
# packages/ package lists (data), fragments/ text inserted into Ryoku's files,
# plugins/ bundled shell plugins, tests/ the sandboxed test suite.
set -euo pipefail

ARM_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
for lib in log env choices upstream pkg blocks steps; do
  # shellcheck source=/dev/null
  source "$ARM_DIR/lib/$lib.sh"
done
load_steps

usage() {
  cat <<'EOF'
Usage: ryoku-arm <command> [options]

  install [choices]           install Ryoku (what ryoku-aarch64.sh runs)
  update [choices] [--system] bring everything current; --system also runs
                              pacman -Syu (passed to `ryoku update`)
  status                      `ryoku status`, aarch64 checks, saved choices
  snapshots                   snapper snapshots of /
  rollback [N] [--apply]      make snapshot N the root again
  help                        this help (`ryoku-arm debug` for internals)

install and update take --dry-run (print the plan, change nothing) and these
choices (every on/off one is on unless you pass --no-X; --X turns it back on),
saved and honoured by every later run:
EOF
  choices_help
}

debug_usage() {
  cat <<'EOF'
Usage: ryoku-arm debug <command>   (internal, for debugging)

  steps                       the ordered step list
  step <name>... [--dry-run]  run only these steps, with the saved choices
  choices                     the saved (or inferred) choices
  self-update                 pull this port from jccr/ryoku-aarch64
EOF
}

# install/update args: choice flags, --dry-run, and `ryoku update`'s own.
parse_args() {
  while (($#)); do
    case $1 in
      --dry-run) DRY=1; shift ;;
      --system|--full|-v|--verbose) UPDATE_ARGS+=("$1"); shift ;;
      -h|--help) usage; exit 0 ;;
      *) choice_flag "$1" "${2:-}" || die "unknown option: $1 (ryoku-arm help)"
         shift "$FLAG_ARGS" ;;
    esac
  done
}

load_choices() {
  choices_load
  choices_infer
  CHANNEL=$(choice ref)
}

self_update() {
  if [[ -d $SHARE/.git ]]; then
    git -C "$SHARE" pull --quiet --ff-only || warn "could not update $(tilde "$SHARE")"
  else
    git clone --quiet --depth 1 https://github.com/jccr/ryoku-aarch64.git "$SHARE"
  fi
  mkdir -p "$BIN"
  ln -sf "$SHARE/ryoku-arm" "$BIN/ryoku-arm"
}

converge() { # verb args...
  local verb=$1 rc=0; shift
  load_choices
  parse_args "$@"
  CHANNEL=$(choice ref)
  choices_save
  dry && say "dry run: nothing is changed"
  sudo_begin
  run_steps "${STEPS[@]}" || rc=$?
  if ((rc)); then warn "$verb finished with failures (above)"; return "$rc"; fi
  say "$verb done"
  if [[ $verb == install ]] && ! dry; then
    say "next: reboot and log in (session: Hyprland); later: ryoku-arm update"
  fi
}

cmd_update() {
  # pull the port first and re-exec, so this run already has its new steps
  if [[ -z ${RYOKU_ARM_UPDATED:-} && ${RYOKU_ARM_SELF_UPDATE:-1} == 1 && " $* " != *" --dry-run "* ]]; then
    local before after
    before=$(git -C "$SHARE" rev-parse HEAD 2>/dev/null || true)
    self_update
    after=$(git -C "$SHARE" rev-parse HEAD 2>/dev/null || true)
    if [[ $before != "$after" ]]; then
      say "ryoku-arm updated to ${after:0:7}; restarting it"
      RYOKU_ARM_UPDATED=1 exec "$SHARE/ryoku-arm" update "$@"
    fi
  fi
  converge update "$@"
}

cmd_status() {
  local disp type
  load_choices
  ryoku status || true
  echo
  say "aarch64"
  if have_repo; then
    printf '  %-16s %s @ %s %s\n' checkout "$(tilde "$(repo)")" \
      "$(git -C "$(repo)" symbolic-ref --short --quiet HEAD 2>/dev/null || echo detached)" \
      "$(git -C "$(repo)" rev-parse --short HEAD)"
  fi
  printf '  %-16s %s\n' ryoku-arm "$(git -C "$ARM_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
  disp=$(loginctl show-user "$USER" -p Display --value 2>/dev/null || true)
  type=$([[ -n $disp ]] && loginctl show-session "$disp" -p Type --value 2>/dev/null || true)
  printf '  %-16s %s\n' login-session "${disp:-none} (${type:-?})"
  [[ $type == wayland || -z $disp ]] || warn "display session is $type, not wayland: log in through SDDM, or polkit will deny the shell"
  echo
  say "choices ($(tilde "$CHOICES_FILE"))"
  choices_print
}

cmd_debug() {
  local sub=${1:-} names=() a
  (($#)) && shift
  case $sub in
    steps) steps_list ;;
    step)
      for a in "$@"; do if [[ $a == --dry-run ]]; then DRY=1; else names+=("$a"); fi; done
      ((${#names[@]})) || die "which step? (ryoku-arm debug steps)"
      load_choices
      sudo_begin
      run_steps "${names[@]}" ;;
    choices) load_choices; choices_print ;;
    self-update) self_update; say "ryoku-arm at $(git -C "$SHARE" rev-parse --short HEAD)" ;;
    ""|-h|--help|help) debug_usage ;;
    *) die "unknown debug command: $sub (ryoku-arm debug)" ;;
  esac
}

[[ $EUID -ne 0 ]] || die "run as your normal user; sudo is used where needed"

case ${1:-} in
  install)   shift; converge install "$@" ;;
  update)    shift; cmd_update "$@" ;;
  status)    cmd_status ;;
  snapshots) snapper -c root list ;;
  rollback)  shift; exec "$ARM_DIR/snapshot-rollback.sh" "$@" ;;
  debug)     shift; cmd_debug "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (ryoku-arm help)" ;;
esac
